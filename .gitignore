# ---------------------------------------------------------------------------
# Unity generated — never commit these. Unity rebuilds them from Assets/ and
# ProjectSettings/, and Library/ alone can reach several GB.
# ---------------------------------------------------------------------------
/[Ll]ibrary/
/[Tt]emp/
/[Oo]bj/
/[Bb]uild/
/[Bb]uilds/
/[Ll]ogs/
/[Uu]ser[Ss]ettings/
/[Mm]emoryCaptures/
/[Rr]ecordings/

# Asset Store tools
/[Aa]ssets/AssetStoreTools*
/[Aa]ssets/Plugins/Editor/JetBrains*

# ---------------------------------------------------------------------------
# IDE / OS
# ---------------------------------------------------------------------------
.vs/
.vscode/
.idea/
*.csproj
*.unityproj
*.sln
*.suo
*.user
*.userprefs
*.pidb
*.booproj
*.svd
*.pdb
*.mdb
*.opendb
*.VC.db
.DS_Store
Thumbs.db
desktop.ini

# Unity3D generated meta for other DCC files
/[Aa]ssets/[Ss]treamingAssets/aa.meta
/[Aa]ssets/[Ss]treamingAssets/aa/*

# ---------------------------------------------------------------------------
# Builds and crash logs
# ---------------------------------------------------------------------------
*.apk
*.aab
*.unitypackage
*.app
crashlytics-build.properties
sysinfo.txt

# ---------------------------------------------------------------------------
# PROJECT-SPECIFIC — the heavy source assets.
#
# The Marble worlds (512 MB across nine .spz) and the rigged masters (278 MB)
# come from the muse-infinity `worlds-v1` GitHub release, not from git. Unity's
# converted GaussianSplatAsset files are large too and are regenerated by the
# importer. Committing any of it would exhaust the LFS quota immediately.
#
# Refetch with:
#   gh release download worlds-v1 -R SkylarWJY/muse-infinity
# See ../muse-infinity/assets/worlds/ for the already-downloaded copies.
# ---------------------------------------------------------------------------
/[Aa]ssets/Worlds/
/[Aa]ssets/Worlds.meta
/[Aa]ssets/Characters/
/[Aa]ssets/Characters.meta
*.spz
*.spz.meta

# Generated splat assets (regenerated from the .spz by the importer)
/[Aa]ssets/GaussianAssets/
/[Aa]ssets/GaussianAssets.meta

# Verification screenshots — not artefacts, and *.png is LFS-tracked below,
# so these would otherwise eat quota for nothing.
/[Aa]ssets/[Ss]creenshots/
/[Aa]ssets/[Ss]creenshots.meta

# Local secrets. Nothing with a key in it goes in git.
.env
.env.local

# ---------------------------------------------------------------------------
# Vendor SDKs that are licence-gated. Each developer must accept PICO's SDK
# licence themselves before downloading, so these are not redistributable here
# and are not committed. 87 MB+ each, which git would not thank us for either.
#
# Get them from https://developer.picoxr.com/resources/?platform=unity
#   PICO Unity OpenXR SDK -> LocalPackages/com.unity.xr.openxr.picoxr
# manifest.json references them by relative path.
# ---------------------------------------------------------------------------
/LocalPackages/

# ---------------------------------------------------------------------------
# Generated by `pico-cli setup`. Regenerate with:
#   pico-cli setup --agent-tool claude-code --scope local --platform unity \
#     --project "<this repo>" --yes
#
# .pico-env.json holds absolute paths to the developer's home directory, so it
# is machine-specific and must not be shared. The skills are vendor content
# that pico-cli re-fetches, so there is no reason to carry them in git.
# .mcp.json, CLAUDE.md and the AGENTS.md ARE committed -- they are small and
# tell a collaborator what this project expects.
# ---------------------------------------------------------------------------
/.pico-env.json
/.claude/skills/

# Marble API downloads — generated worlds, refetchable, some are large
/Tools/marble/worlds-out/

# API keys injected into StreamingAssets by KeyInjectionBuildStep for the duration of a
# build and deleted again afterwards. If a build dies mid-way they survive on disk, and
# `git add -A` would commit a live key. Belt and braces, matching MusePico.
/[Aa]ssets/[Ss]treamingAssets/*.key
/[Aa]ssets/[Ss]treamingAssets/*.key.meta

# Verification screenshots. *.png is LFS-tracked here; these must not eat the quota.
/[Aa]ssets/Screenshots/
/[Aa]ssets/Screenshots.meta
