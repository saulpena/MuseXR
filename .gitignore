# ---------------------------------------------------------------------------
# Unity generated — never commit these. Unity rebuilds them from Assets/ and
# ProjectSettings/, and Library/ alone can reach several GB.
# ---------------------------------------------------------------------------
/[Ll]ibrary/
/[Tt]emp/
/[Oo]bj/
/[Bb]uild/
/[Bb]uilds/
/[Ll]ogs/
/[Uu]ser[Ss]ettings/
/[Mm]emoryCaptures/
/[Rr]ecordings/

# Asset Store tools
/[Aa]ssets/AssetStoreTools*
/[Aa]ssets/Plugins/Editor/JetBrains*

# ---------------------------------------------------------------------------
# IDE / OS
# ---------------------------------------------------------------------------
.vs/
.vscode/
.idea/
*.csproj
*.unityproj
*.sln
*.suo
*.user
*.userprefs
*.pidb
*.booproj
*.svd
*.pdb
*.mdb
*.opendb
*.VC.db
.DS_Store
Thumbs.db
desktop.ini

# Unity3D generated meta for other DCC files
/[Aa]ssets/[Ss]treamingAssets/aa.meta
/[Aa]ssets/[Ss]treamingAssets/aa/*

# ---------------------------------------------------------------------------
# Builds and crash logs
# ---------------------------------------------------------------------------
*.apk
*.aab
*.unitypackage
*.app
crashlytics-build.properties
sysinfo.txt

# ---------------------------------------------------------------------------
# PROJECT-SPECIFIC — the heavy source assets.
#
# The Marble worlds (512 MB across nine .spz) and the rigged masters (278 MB)
# come from the muse-infinity `worlds-v1` GitHub release, not from git. Unity's
# converted GaussianSplatAsset files are large too and are regenerated by the
# importer. Committing any of it would exhaust the LFS quota immediately.
#
# Refetch with:
#   gh release download worlds-v1 -R SkylarWJY/muse-infinity
# See ../muse-infinity/assets/worlds/ for the already-downloaded copies.
# ---------------------------------------------------------------------------
/[Aa]ssets/Worlds/
/[Aa]ssets/Worlds.meta
/[Aa]ssets/Characters/
/[Aa]ssets/Characters.meta
*.spz
*.spz.meta

# Generated splat assets (regenerated from the .spz by the importer)
/[Aa]ssets/GaussianAssets/
/[Aa]ssets/GaussianAssets.meta

# Verification screenshots — not artefacts, and *.png is LFS-tracked below,
# so these would otherwise eat quota for nothing.
/[Aa]ssets/[Ss]creenshots/
/[Aa]ssets/[Ss]creenshots.meta

# Local secrets. Nothing with a key in it goes in git.
.env
.env.local
